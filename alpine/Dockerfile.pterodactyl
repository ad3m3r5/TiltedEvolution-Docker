ARG VERSION=latest

FROM ad3m3r5/tiltedevolution:server-$VERSION AS server

USER root
RUN mkdir -p /out \
    && cp /home/tilted/libSTServer.so /home/tilted/SkyrimTogetherServer /out/ \
    && if [ -f /home/tilted/crashpad_handler ]; then cp /home/tilted/crashpad_handler /out/; fi

FROM alpine:3.23

ARG USER=container

ENV USER=$USER \
    HOME=/home/$USER

RUN apk upgrade --no-cache \
    && apk add --no-cache \
      ca-certificates \
      tzdata \
      openssl \
      libstdc++ \
    && adduser --disabled-password --home /home/$USER $USER

COPY --from=server --chown=container:container /out/ /home/server/

COPY --chown=container:container ./alpine/entrypoint.sh /entrypoint.sh

USER $USER
WORKDIR /home/$USER

ENTRYPOINT []
CMD ["/bin/ash", "/entrypoint.sh"]
