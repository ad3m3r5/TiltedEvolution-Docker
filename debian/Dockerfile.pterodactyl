ARG VERSION=latest

FROM ad3m3r5/tiltedevolution:server-$VERSION-debian AS server

USER root
RUN mkdir -p /out \
  && cp /home/tilted/libSTServer.so /home/tilted/SkyrimTogetherServer /out/ \
  && if [ -f /home/tilted/crashpad_handler ]; then cp /home/tilted/crashpad_handler /out/; fi

FROM debian:13

ARG USER=container

ENV USER=$USER \
    HOME=/home/$USER

RUN apt update \
  && apt install -y --no-install-recommends \
      adduser \
  && rm -rf /var/lib/apt/lists/* \
  && adduser --disabled-password --gecos "" $USER

COPY --from=server --chown=container:container /out/ /home/server/

COPY --chown=container:container ./debian/entrypoint.sh /entrypoint.sh

USER $USER
WORKDIR /home/$USER

ENTRYPOINT []
CMD ["/bin/bash", "/entrypoint.sh"]
